HardSphereB5Lean.flat_measure_general : ∀ (K : HardSphereB5.Lean.Pt → HardSphereB5.Lean.Pt → ℝ),
  MeasureTheory.Integrable (Function.uncurry K)
      (((SphereGeom.sphereMeasure 0).restrict HardSphereB5.SphericalCrofton.FA).prod
        ((SphereGeom.sphereMeasure HardSphereB5.Lean.e).restrict HardSphereB5.SphericalCrofton.FB)) →
    (∀ (R : HardSphereB5.Lean.Pt ≃ₗᵢ[ℝ] HardSphereB5.Lean.Pt),
        HardSphereB5.SphericalCrofton.IsAxialRotation R →
          ∀ p ∈ HardSphereB5.SphericalCrofton.FA, ∀ p' ∈ HardSphereB5.SphericalCrofton.FB, K (R p) (R p') = K p p') →
      ∫ (p : SphereGeom.E3) in HardSphereB5.SphericalCrofton.FA,
          ∫ (p' : SphereGeom.E3) in HardSphereB5.SphericalCrofton.FB,
            K p p' ∂SphereGeom.sphereMeasure HardSphereB5.Lean.e ∂SphereGeom.sphereMeasure 0 =
        Real.pi / 2 *
          ∫ (v : ℝ × ℝ × ℝ) in HardSphereB5.SphericalCrofton.Dfull,
            (K (HardSphereB5.SphericalCrofton.pRep v.1)
                  (HardSphereB5.SphericalCrofton.pRep2 v.2.1 (HardSphereB5.SphericalCrofton.chiPlus v.1 v.2.1 v.2.2)) +
                K (HardSphereB5.SphericalCrofton.pRep v.1)
                  (HardSphereB5.SphericalCrofton.pRep2 v.2.1
                    (-HardSphereB5.SphericalCrofton.chiPlus v.1 v.2.1 v.2.2))) /
              √(HardSphereB5.SphericalCrofton.Hpoly v.1 v.2.1 v.2.2)
HardSphereB5Lean.flat_measure_reflection_even : ∀ (K : HardSphereB5.Lean.Pt → HardSphereB5.Lean.Pt → ℝ),
  MeasureTheory.Integrable (Function.uncurry K)
      (((SphereGeom.sphereMeasure 0).restrict HardSphereB5.SphericalCrofton.FA).prod
        ((SphereGeom.sphereMeasure HardSphereB5.Lean.e).restrict HardSphereB5.SphericalCrofton.FB)) →
    (∀ (R : HardSphereB5.Lean.Pt ≃ₗᵢ[ℝ] HardSphereB5.Lean.Pt),
        R HardSphereB5.Lean.e = HardSphereB5.Lean.e →
          ∀ p ∈ HardSphereB5.SphericalCrofton.FA, ∀ p' ∈ HardSphereB5.SphericalCrofton.FB, K (R p) (R p') = K p p') →
      ∫ (p : SphereGeom.E3) in HardSphereB5.SphericalCrofton.FA,
          ∫ (p' : SphereGeom.E3) in HardSphereB5.SphericalCrofton.FB,
            K p p' ∂SphereGeom.sphereMeasure HardSphereB5.Lean.e ∂SphereGeom.sphereMeasure 0 =
        Real.pi *
          ∫ (v : ℝ × ℝ × ℝ) in HardSphereB5.SphericalCrofton.Dfull,
            K (HardSphereB5.SphericalCrofton.pRep v.1)
                (HardSphereB5.SphericalCrofton.pRep2 v.2.1 (HardSphereB5.SphericalCrofton.chiPlus v.1 v.2.1 v.2.2)) /
              √(HardSphereB5.SphericalCrofton.Hpoly v.1 v.2.1 v.2.2)
HardSphereB5Lean.flat_measure_target : ∀ (f : HardSphereB5.SphericalCrofton.Kern),
  HardSphereB5.SphericalCrofton.frakB f =
    Real.pi *
      ∫ (v : ℝ × ℝ × ℝ) in HardSphereB5.SphericalCrofton.Dnear,
        1 / √(HardSphereB5.SphericalCrofton.Hpoly v.1 v.2.1 v.2.2) *
            (HardSphereB5.SphericalCrofton.rhoK f (1 - v.2.2 / 2) / √v.2.2) *
          HardSphereB5.SphericalCrofton.circInt (HardSphereB5.SphericalCrofton.pRep v.1)
            (HardSphereB5.SphericalCrofton.pRep2 v.2.1 (HardSphereB5.SphericalCrofton.chiPlus v.1 v.2.1 v.2.2))
@HardSphereB5Lean.hit_mass : ∀ {K : Set HardSphereB5.Lean.Pt},
  HardSphereB5.SphericalCrofton.IsRegularRegionCrofton K →
    (SphereGeom.gcIntegral fun G => if 0 < HardSphereB5.SphericalCrofton.chordLen K G then 1 else 0) =
      HardSphereB5.SphericalCrofton.perim K
HardSphereB5Lean.literal_crofton_false : ∀ (n : HardSphereB5.Lean.Pt),
  ‖n‖ = 1 →
    ∀ (f : HardSphereB5.SphericalCrofton.Kern),
      HardSphereB5.SphericalCrofton.Ff f (SphereGeom.cap n (Real.cos (Real.pi / 6))) ≠
        HardSphereB5.SphericalCrofton.cA f *
              HardSphereB5.SphericalCrofton.sArea (SphereGeom.cap n (Real.cos (Real.pi / 6))) -
            HardSphereB5.SphericalCrofton.cP f *
              HardSphereB5.SphericalCrofton.perim (SphereGeom.cap n (Real.cos (Real.pi / 6))) +
          HardSphereB5.SphericalCrofton.RfAll f (SphereGeom.cap n (Real.cos (Real.pi / 6)))
@HardSphereB5Lean.literal_remainder_excess : ∀ {K : Set HardSphereB5.Lean.Pt},
  HardSphereB5.SphericalCrofton.IsRegularRegionCrofton K →
    ∀ (f : HardSphereB5.SphericalCrofton.Kern),
      HardSphereB5.SphericalCrofton.RfAll f K =
        HardSphereB5.SphericalCrofton.Rf f K +
          HardSphereB5.SphericalCrofton.bK f * (2 * Real.pi - HardSphereB5.SphericalCrofton.perim K)
HardSphereB5Lean.sigma_support : ∀ D ∈ HardSphereB5.SphericalCrofton.LamC,
  HardSphereB5.SphericalCrofton.offAxis D →
    (HardSphereB5.SphericalCrofton.Rc ‖D‖ ‖D - HardSphereB5.Lean.e‖ < 1 →
        0 < HardSphereB5.SphericalCrofton.sArea (HardSphereB5.SphericalCrofton.SigmaD D) ∧
          ∃ V W, V ≠ W ∧ HardSphereB5.SphericalCrofton.vertsD D = {V, W}) ∧
      (HardSphereB5.SphericalCrofton.Rc ‖D‖ ‖D - HardSphereB5.Lean.e‖ = 1 →
          ∃ V, HardSphereB5.SphericalCrofton.SigmaD D = {V}) ∧
        (1 < HardSphereB5.SphericalCrofton.Rc ‖D‖ ‖D - HardSphereB5.Lean.e‖ →
          HardSphereB5.SphericalCrofton.SigmaD D = ∅)
HardSphereB5Lean.spherical_remainder_split : ∀ (f : HardSphereB5.SphericalCrofton.Kern),
  ∀ D ∈ HardSphereB5.SphericalCrofton.LamC,
    HardSphereB5.SphericalCrofton.Rf f (HardSphereB5.SphericalCrofton.SigmaD D) =
      HardSphereB5.SphericalCrofton.AAf f D + HardSphereB5.SphericalCrofton.BBf f D +
        HardSphereB5.SphericalCrofton.ABf f D
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_bulk_patch_area : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt}
  {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    0 < HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s →
      ∀ (i : Fin 4),
        HardSphereB5.Lean.Geometry.PathCore.pArea c i Finset.univ =
          (-Real.pi +
              1 / 2 *
                ∑ l,
                  if l ≠ i then
                    HardSphereB5.Lean.Geometry.PathCore.pArea c i (HardSphereB5.Lean.Geometry.PathCore.faceSet l)
                  else 0) +
            1 / 2 * ∑ j, if j ≠ i then dist (c i) (c j) * HardSphereB5.Lean.Geometry.PathCore.phiE c i j else 0
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_bulk_patch_moment : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt}
  {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    0 < HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s →
      ∀ (i : Fin 4),
        HardSphereB5.Lean.Geometry.PathCore.pMoment c i Finset.univ =
          (((1 / 2) •
                ∑ l,
                  if l ≠ i then
                    HardSphereB5.Lean.Geometry.PathCore.pMoment c i (HardSphereB5.Lean.Geometry.PathCore.faceSet l)
                  else 0) -
              (1 / 2) •
                ∑ j,
                  if j ≠ i then
                    ((1 - HardSphereB5.Lean.Geometry.PathCore.q c i j / 4) /
                          √(HardSphereB5.Lean.Geometry.PathCore.q c i j) *
                        HardSphereB5.Lean.Geometry.PathCore.phiE c i j) •
                      (c j - c i)
                  else 0) +
            ∑ l, if l ≠ i then HardSphereB5.Lean.Geometry.PathCore.apexTerm c i l else 0
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_bulk_volume : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt} {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    0 < HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s →
      HardSphereB5.Lean.Geometry.PathCore.vol c Finset.univ =
        (1 / 2 * ∑ l, HardSphereB5.Lean.Geometry.PathCore.vol c (HardSphereB5.Lean.Geometry.PathCore.faceSet l) -
              4 * Real.pi / 3 +
            1 / 2 *
              ∑ i,
                ∑ j,
                  if i < j then
                    HardSphereB5.Lean.Geometry.PathCore.g (dist (c i) (c j)) *
                      HardSphereB5.Lean.Geometry.PathCore.phiE c i j
                  else 0) -
          √(HardSphereB5.Lean.Geometry.PathCore.Hpoly X Y s) / 12
HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_near_volume_inventory : HardSphereB5.Lean.Geometry.PathCore.Kcap =
  2 * HardSphereB5.Lean.Geometry.PathCore.Vadj + 2 * HardSphereB5.Lean.Geometry.PathCore.Vnon +
            HardSphereB5.Lean.Geometry.PathCore.Ccap +
          HardSphereB5.Lean.Geometry.PathCore.Dcap +
        2 * HardSphereB5.Lean.Geometry.PathCore.Eadj +
      2 * HardSphereB5.Lean.Geometry.PathCore.Enon +
    ∑ i, ∑ j, if i < j then HardSphereB5.Lean.Geometry.PathCore.nearPairArc i j else 0
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_normal_form_patch : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt}
  {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s ≠ 0 →
      ∀ (i : Fin 4),
        (HardSphereB5.Lean.Geometry.PathCore.pArea c i Finset.univ =
            (2 * Real.pi -
                ∑ l,
                  if l ≠ i then
                    ↑(HardSphereB5.Lean.Geometry.PathCore.nRet c l) *
                      HardSphereB5.Lean.Geometry.PathCore.gammaA c i (HardSphereB5.Lean.Geometry.PathCore.oth1 i l)
                        (HardSphereB5.Lean.Geometry.PathCore.oth2 i l)
                  else 0) -
              1 / 2 * ∑ j, if j ≠ i then dist (c i) (c j) * HardSphereB5.Lean.Geometry.PathCore.ell c i j else 0) ∧
          HardSphereB5.Lean.Geometry.PathCore.pMoment c i Finset.univ =
            (((1 / 2) •
                  ∑ j,
                    if j ≠ i then
                      ((1 - HardSphereB5.Lean.Geometry.PathCore.q c i j / 4) / dist (c i) (c j) *
                          HardSphereB5.Lean.Geometry.PathCore.ell c i j) •
                        (c j - c i)
                    else 0) +
                ∑ l,
                  if l ≠ i then
                    (↑(HardSphereB5.Lean.Geometry.PathCore.nRet c l) *
                          √(HardSphereB5.Lean.Geometry.PathCore.Qface c l) /
                        (2 *
                          HardSphereB5.Lean.Geometry.PathCore.Deltaf c i (HardSphereB5.Lean.Geometry.PathCore.oth1 i l)
                            (HardSphereB5.Lean.Geometry.PathCore.oth2 i l))) •
                      HardSphereB5.Lean.Geometry.PathCore.endTerm c i l
                  else 0) +
              if 0 < HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s then
                ∑ l, if l ≠ i then HardSphereB5.Lean.Geometry.PathCore.apexTerm c i l else 0
              else 0
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_normal_form_volume : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt}
  {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s ≠ 0 →
      HardSphereB5.Lean.Geometry.PathCore.vol c Finset.univ =
        (8 * Real.pi / 3 -
                1 / 3 *
                  ∑ l,
                    ↑(HardSphereB5.Lean.Geometry.PathCore.nRet c l) * HardSphereB5.Lean.Geometry.PathCore.sigmaF c l -
              1 / 2 *
                ∑ i,
                  ∑ j,
                    if i < j then
                      HardSphereB5.Lean.Geometry.PathCore.g (dist (c i) (c j)) *
                        HardSphereB5.Lean.Geometry.PathCore.ell c i j
                    else 0) +
            1 / 12 *
              ∑ l, ↑(HardSphereB5.Lean.Geometry.PathCore.nRet c l) * √(HardSphereB5.Lean.Geometry.PathCore.Qface c l) -
          if 0 < HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s then
            √(HardSphereB5.Lean.Geometry.PathCore.Hpoly X Y s) / 12
          else 0
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_raw_endpoint_volume : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt}
  {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s ≠ 0 →
      ∀
        (D :
          (e : HardSphereB5.Lean.Geometry.PathCore.PairIndex) →
            HardSphereB5.Lean.Geometry.PathCore.PairArcDecomposition c (↑e).1 (↑e).2),
        HardSphereB5.Lean.Geometry.PathCore.vol c Finset.univ =
          (8 * Real.pi / 3 -
                1 / 3 *
                  ∑ l,
                    ↑(HardSphereB5.Lean.Geometry.PathCore.nRet c l) * HardSphereB5.Lean.Geometry.PathCore.sigmaF c l -
              1 / 2 *
                ∑ i,
                  ∑ j,
                    if i < j then
                      HardSphereB5.Lean.Geometry.PathCore.g (dist (c i) (c j)) *
                        HardSphereB5.Lean.Geometry.PathCore.ell c i j
                    else 0) +
            HardSphereB5.Lean.Geometry.PathCore.rawEndpointSum c D / 6
@HardSphereB5Lean.HardSphereB5_Lean_Geometry_PathCore_weighted_channel_normal_form : ∀
  {c : Fin 4 → HardSphereB5.Lean.Pt} {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    HardSphereB5.Lean.Geometry.PathCore.P4poly X Y s ≠ 0 →
      ∀ (h ε : ℝ),
        h = HardSphereB5.Lean.Geometry.PathCore.channelH2 Y ∧ ε = -1 ∨
            h = HardSphereB5.Lean.Geometry.PathCore.channelH3 X Y s ∧ ε = 1 →
          HardSphereB5.Lean.Geometry.PathCore.channelDensity c X h ε =
            (4 * Real.pi * HardSphereB5.Lean.Geometry.PathCore.hcWeight X * h -
                  ∑ i,
                    ∑ j,
                      if i < j then
                        HardSphereB5.Lean.Geometry.PathCore.channelArcCoeff c X h ε i j *
                          HardSphereB5.Lean.Geometry.PathCore.ell c i j
                      else 0) +
                HardSphereB5.Lean.Geometry.PathCore.channelCorner c X h +
              HardSphereB5.Lean.Geometry.PathCore.channelEndpoint c X Y s h ε
HardSphereB5Lean.pair_replacement_patch_ae : ∀ (x : Fin 3 → HardSphereB5.Lean.Pt),
  AffineIndependent ℝ x →
    dist (x 1) (x 2) ^ 2 < 4 →
      dist (x 0) (x 1) ^ 2 ≤ 1 →
        dist (x 0) (x 2) ^ 2 ≤ 1 →
          dist (x 0) (x 1) ^ 2 ≤ dist (x 1) (x 2) ^ 2 ∧ dist (x 0) (x 2) ^ 2 ≤ dist (x 1) (x 2) ^ 2 →
            HardSphereB5.Lean.Geometry.PathCore.QT (dist (x 1) (x 2) ^ 2) (dist (x 1) (x 0) ^ 2)
                  (dist (x 2) (x 0) ^ 2) ≤
                0 →
              ∀ (i : Fin 3),
                ⋂ j, Metric.closedBall (x j) 1 =ᵐ[SphereGeom.sphereMeasure (x i)]
                  if i = 0 then ∅ else Metric.closedBall (x 1) 1 ∩ Metric.closedBall (x 2) 1
@HardSphereB5Lean.realizable_classification : ∀ {c : Fin 4 → HardSphereB5.Lean.Pt} {X Y s : ℝ},
  HardSphereB5.Lean.Geometry.PathCore.IsPathConfig c X Y s →
    ∃ φ, ∀ (i : Fin 4), φ (c i) = HardSphereB5.Lean.Geometry.PathCore.canonicalCenters X Y s i
